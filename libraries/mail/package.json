{
  "name": "@itookit/mail",
  "version": "0.1.0",
  "description": "Portable indexed VFS mail archive with paginated threads and a host-injected reader.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {".": "./src/index.ts", "./contracts": "./src/contracts/index.ts", "./ui": "./src/ui/index.ts", "./ui.css": "./src/ui/mail.css"},
  "scripts": {"build": "tsup", "typecheck": "tsc --noEmit", "test": "vitest run"},
  "peerDependencies": {"@itookit/vfs-core": "^5.3.4"},
  "dependencies": {"@itookit/ui-common": "^0.1.0"},
  "devDependencies": {"@itookit/vfs-core": "workspace:*", "typescript": "^5.9.3", "tsup": "^8.5.0", "vitest": "^3.2.4", "jsdom": "^27.4.0"},
  "files": ["dist"],
  "publishConfig": {"main": "./dist/index.cjs", "types": "./dist/index.d.ts", "exports": {
    ".": {"import": {"types": "./dist/index.d.ts", "default": "./dist/index.js"}, "require": {"types": "./dist/index.d.cts", "default": "./dist/index.cjs"}},
    "./contracts": {"import": {"types": "./dist/contracts/index.d.ts", "default": "./dist/contracts/index.js"}, "require": {"types": "./dist/contracts/index.d.cts", "default": "./dist/contracts/index.cjs"}},
    "./ui": {"import": {"types": "./dist/ui/index.d.ts", "default": "./dist/ui/index.js"}, "require": {"types": "./dist/ui/index.d.cts", "default": "./dist/ui/index.cjs"}},
    "./ui.css": "./dist/ui/mail.css"
  }}
}
