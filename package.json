{
  "name": "nestos-workspace",
  "version": "0.5.3",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter nestos-web dev",
    "httpd": "node scripts/httpd.mjs start",
    "httpd:status": "node scripts/httpd.mjs status",
    "httpd:switch": "node scripts/httpd.mjs switch",
    "httpd:stop": "node scripts/httpd.mjs stop",
    "httpd:restart": "node scripts/httpd.mjs restart",
    "temp:run": "node tools/temporary-process/node/cli.mjs run",
    "temp:recover": "node tools/temporary-process/node/cli.mjs recover",
    "build": "node scripts/business-workspace.mjs build",
    "build:libs": "node scripts/business-workspace.mjs build:libs",
    "test": "pnpm architecture:check && pnpm test:tooling && node scripts/test-all.mjs",
    "release": "pnpm --filter ./apps/web-app build && node scripts/release.js",
    "deploy:pages": "pnpm --filter ./apps/web-app build && node scripts/deploy-gh-pages.js",
    "tauri:dev": "pnpm --filter tauri-app tauri:dev",
    "tau": "pnpm --filter tauri-app tauri:dev",
    "tauri:build": "pnpm build:libs && pnpm --filter tauri-app tauri:build",
    "cli": "pnpm --filter @nestos/cli dev",
    "cli:build": "pnpm --filter @nestos/cli build",
    "migrate:legacy-chats": "pnpm --filter @nestos/cli exec tsx scripts/migrate-legacy-chats.ts",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "node scripts/business-workspace.mjs typecheck",
    "docs:check": "node scripts/check-docs.mjs",
    "styles:check": "node scripts/check-styles.mjs",
    "uuid:check": "node --test scripts/tests/check-browser-uuid.test.mjs && node scripts/check-browser-uuid.mjs",
    "architecture:check": "pnpm uuid:check && node --test scripts/tests/check-boundaries.test.mjs && node scripts/check-boundaries.mjs && pnpm modules:check",
    "test:matrix": "pnpm architecture:check && pnpm test:tooling && node scripts/test-all.mjs",
    "npm:prepare": "node scripts/release-npm-libraries.mjs prepare",
    "npm:publish": "node scripts/release-npm-libraries.mjs publish",
    "workspace:check": "node scripts/check-workspace.mjs",
    "preinstall": "node scripts/check-workspace.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "modules:check": "node --test scripts/tests/check-module-separation.test.mjs && node scripts/check-module-separation.mjs",
    "modules:buildcheck": "node scripts/check-frontend-build.mjs",
    "httpd:build": "node scripts/httpd.mjs build",
    "httpd:dev": "node scripts/httpd.mjs dev",
    "httpd:list": "node scripts/httpd.mjs list",
    "httpd:activate": "node scripts/httpd.mjs activate",
    "libraries:snapshot": "node scripts/local-libraries.mjs snapshot",
    "libraries:use": "node scripts/local-libraries.mjs use",
    "libraries:source": "node scripts/local-libraries.mjs source",
    "libraries:status": "node scripts/local-libraries.mjs status",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "lib:build": "node scripts/local-libraries.mjs build",
    "cli:built": "node apps/cli/dist/cli.js",
    "nestos:pack": "node scripts/release-nestos.mjs prepare",
    "nestos:publish": "node scripts/release-nestos.mjs publish",
    "test:kanban-settings-browser": "node scripts/verify-kanban-decision-filter.mjs settings",
    "test:kanban-browser": "node scripts/verify-kanban-decision-filter.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "performance:session": "node tools/temporary-process/node/cli.mjs run --timeout-ms 180000 -- pnpm --filter @nestos/cli exec tsx scripts/profile-session-switch.ts --gate",
    "test:native-queue-browser": "node scripts/verify-kanban-decision-filter.mjs queue-recovery",
    "test:kanban-cancel-browser": "node scripts/verify-kanban-decision-filter.mjs operation-cancel",
    "test:kanban-progress-browser": "node scripts/verify-kanban-decision-filter.mjs operation-progress",
    "test:kanban-skips-browser": "node scripts/verify-kanban-decision-filter.mjs operation-skips",
    "test:kanban-native-browser": "node scripts/verify-kanban-decision-filter.mjs native-activity"
  },
  "keywords": [],
  "author": "lizlok@gmail.com",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "jsdoc": "^4.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "@nestos/vfs-sync": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "@nestos/vfs-ui": "workspace:*",
    "@nestos/vfsdriver-indexeddb": "workspace:*",
    "@nestos/vfsdriver-local": "workspace:*",
    "@nestos/driver-llm": "workspace:*",
    "@nestos/mdxeditor": "workspace:*",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "jsdoc-tsimport-plugin": "^1.0.5",
    "vite": "^7.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-agentos/NestOS.git"
  },
  "bugs": {
    "url": "https://github.com/nest-agentos/NestOS/issues"
  },
  "homepage": "https://github.com/nest-agentos/NestOS#readme"
}
