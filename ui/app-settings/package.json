{
  "name": "@nestos/app-settings",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./style.css": "./src/styles/styles.css"
  },
  "publishConfig": {
    "main": "./dist/app-settings.umd.cjs",
    "module": "./dist/app-settings.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/app-settings.js",
        "require": "./dist/app-settings.umd.cjs"
      },
      "./style.css": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestos/common": "workspace:*",
    "@nestos/mdxeditor": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "@nestos/vfs-ui": "workspace:*",
    "@nestos/ui-common-adapter": "workspace:*",
    "@nestos/mdx-adapter": "workspace:*"
  },
  "devDependencies": {
    "@nestos/common": "workspace:*",
    "@nestos/mdxeditor": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "@nestos/vfs-ui": "workspace:*",
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "@nestos/ui-common-adapter": "workspace:*",
    "@nestos/mdx-adapter": "workspace:*",
    "@nestos/driver-llm": "workspace:*",
    "@nestos/tools": "workspace:*",
    "@nestos/kernel-adapters": "workspace:*"
  },
  "dependencies": {
    "@nestos/app-contracts": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@nestos/ui-common": "workspace:*",
    "@nestos/llm-ui": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-agentos/NestOS.git",
    "directory": "ui/app-settings"
  },
  "bugs": {
    "url": "https://github.com/nest-agentos/NestOS/issues"
  },
  "homepage": "https://github.com/nest-agentos/NestOS#readme"
}
