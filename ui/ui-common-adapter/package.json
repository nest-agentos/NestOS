{
  "name": "@nestos/ui-common-adapter",
  "version": "0.1.0",
  "description": "NestOS editor contracts and host adapters for the independent UI foundation.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@nestos/common": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "@nestos/ui-common": "workspace:*"
  },
  "devDependencies": {
    "@nestos/common": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-agentos/NestOS.git",
    "directory": "ui/ui-common-adapter"
  },
  "bugs": {
    "url": "https://github.com/nest-agentos/NestOS/issues"
  },
  "homepage": "https://github.com/nest-agentos/NestOS#readme"
}
