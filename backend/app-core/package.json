{
  "name": "@nestos/app-core",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./profile": {
      "types": "./src/profile/nestos-profile.ts",
      "import": "./src/profile/nestos-profile.ts",
      "default": "./src/profile/nestos-profile.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/backend.ts",
      "import": "./src/contracts/backend.ts",
      "default": "./src/contracts/backend.ts"
    },
    "./kanban": {
      "types": "./src/kanban/index.ts",
      "import": "./src/kanban/index.ts",
      "default": "./src/kanban/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestos/common": "workspace:*",
    "@nestos/durable-kernel": "workspace:*",
    "@nestos/kernel-adapters": "workspace:*",
    "@nestos/llm-flow": "workspace:*",
    "@nestos/llm-session": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "@nestos/driver-llm": "workspace:*",
    "@nestos/llm-context": "workspace:*",
    "@nestos/llm-tasks": "workspace:*",
    "@nestos/tools": "workspace:*",
    "@nestos/vfs-sync": "workspace:*",
    "@nestos/cells-driver": "workspace:*",
    "@nestos/app-contracts": "workspace:*",
    "js-yaml": "^4.1.1",
    "@nestos/kanban": "workspace:*",
    "@nestos/mail": "workspace:*",
    "@nestos/git-delivery": "workspace:*",
    "@nestos/kanban-development": "workspace:*"
  },
  "devDependencies": {
    "@nestos/vfsdriver-indexeddb": "workspace:*",
    "@types/node": "^20.19.25",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@nestos/vfs-ui": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-agentos/NestOS.git",
    "directory": "backend/app-core"
  },
  "bugs": {
    "url": "https://github.com/nest-agentos/NestOS/issues"
  },
  "homepage": "https://github.com/nest-agentos/NestOS#readme"
}
