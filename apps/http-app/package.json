{
  "name": "@nestos/http-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "create:certs": "bash scripts/create-certificates.sh",
    "dev": "node ../../scripts/httpd.mjs dev",
    "build:ui": "vite build",
    "build": "pnpm build:ui && tsup src/server/main.ts --format esm --platform node --out-dir dist-server --splitting",
    "start": "node ../../scripts/httpd.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0",
    "@nestos/common": "workspace:*",
    "@nestos/app-core": "workspace:*",
    "@nestos/app-shell": "workspace:*",
    "@nestos/llm-ui-adapter": "workspace:*",
    "@nestos/mdxeditor": "workspace:*",
    "@nestos/ui-common-adapter": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "@nestos/cells-driver": "workspace:*",
    "@nestos/vfsdriver-local": "workspace:*",
    "nestos-web": "workspace:*",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@nestos/mdx-adapter": "workspace:*",
    "@nestos/app-contracts": "workspace:*",
    "@nestos/kernel-adapters": "workspace:*",
    "@nestos/llm-flow": "workspace:*",
    "@nestos/node-host": "workspace:*",
    "@nestos/app-transport": "workspace:*",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "tsx": "^4.20.6",
    "tsup": "^8.5.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-agentos/NestOS.git",
    "directory": "apps/http-app"
  },
  "bugs": {
    "url": "https://github.com/nest-agentos/NestOS/issues"
  },
  "homepage": "https://github.com/nest-agentos/NestOS#readme"
}
