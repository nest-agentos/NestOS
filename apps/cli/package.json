    "@nestos/driver-llm": "workspace:*",
    "@nestos/device-tty": "workspace:*",
    "@nestos/durable-kernel": "workspace:*",
    "@nestos/llm-flow": "workspace:*",
    "@nestos/llm-session": "workspace:*",
    "@nestos/llm-tasks": "workspace:*",
    "@nestos/vfs-core": "workspace:*",
    "@nestos/tools": "workspace:*",
    "@nestos/vfsdriver-local": "workspace:*",
    "@nestos/app-core": "workspace:*",
    "yaml": "^2.8.2",
    "zod": "^4.1.0",
